table inet fort_probe {
  chain input {
    type filter hook input priority -100; policy drop;
    iifname "lo" accept
    ct state established,related accept
    iifname "eth0" ip saddr 192.168.5.2 udp sport 67 udp dport 68 accept
    iifname "eth0" ip saddr 192.168.5.2 tcp dport 22 ct state new accept
  }
  chain output {
    type filter hook output priority -100; policy drop;
    oifname "lo" accept
    ct state established,related accept
    oifname "eth0" ip daddr { 192.168.5.2, 255.255.255.255 } udp sport 68 udp dport 67 accept
  }
  chain forward {
    type filter hook forward priority -100; policy drop;
  }
}
