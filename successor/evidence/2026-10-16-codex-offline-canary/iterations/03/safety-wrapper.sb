(version 1)
(allow default)
(deny network*)
(deny mach*)
(deny ipc-posix*)
(deny file-read* (subpath "/Users") (subpath "/Volumes"))
(deny file-read-data (require-not (require-any (subpath "/private/tmp/fort-offline-permissions-w1l6ndkh") (literal "/opt/homebrew/Caskroom/codex/0.157.1/bin/codex") (subpath "/System/Library") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/usr/bin") (subpath "/bin") (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom"))))
(deny file-write* (require-not (subpath "/private/tmp/fort-offline-permissions-w1l6ndkh")))
(deny process-exec (require-not (require-any (literal "/opt/homebrew/Caskroom/codex/0.157.1/bin/codex") (literal "/private/tmp/fort-offline-permissions-w1l6ndkh/probe") (literal "/usr/bin/true") (literal "/usr/bin/sandbox-exec"))))
