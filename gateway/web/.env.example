# ---------------------------------------------------------------------------
# Fort gateway web app (spec 028) — environment
#
# Copy to `.env.local` for local dev, or set these in the Vercel project.
# EVERYTHING here is server-side ONLY except NEXT_PUBLIC_GATEWAY_URL. The
# GATEWAY_SECRET must never be exposed to the browser (no NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# --- Auth.js (next-auth v5) -------------------------------------------------
# A random secret used to encrypt the session JWT. Generate with:
#   openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=

# Google OAuth 2.0 Web client credentials (Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID -> Web application).
# Authorized redirect URI must be:
#   https://<your-web-app>/api/auth/callback/google
# For local dev also add: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Fort gateway -----------------------------------------------------------
# Comma-separated list of Google account emails allowed to sign in. Any
# authenticated Google account NOT on this list is rejected (access denied).
#   e.g. FORT_ALLOWLIST=you@example.com,teammate@example.com
FORT_ALLOWLIST=

# Shared secret the web app presents to the Cloudflare worker on every
# internal call (header X-Gateway-Secret). MUST match the worker's
# GATEWAY_SECRET (`wrangler secret put GATEWAY_SECRET`). Server-side only.
GATEWAY_SECRET=

# The Cloudflare worker's base URL (no trailing slash). The web server routes
# proxy relay traffic here. e.g. https://fort-gateway.<you>.workers.dev
WORKER_URL=

# The public gateway URL shown in the `fort relay join <url> --code ...` line
# on the Add-machine page. Usually the same host as the worker (or a custom
# domain in front of it). Safe to expose to the browser.
NEXT_PUBLIC_GATEWAY_URL=
