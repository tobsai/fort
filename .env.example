# Fort — environment template (AO-005). Copy to `.env`; never commit real keys.
# `.env` is git-ignored. Each agent CLI authenticates against its own provider;
# Fort only needs these present in the environment it spawns the CLIs in.

# --- claude (Anthropic) ---
# Used by the `claude` CLI in headless `-p/--print` mode.
ANTHROPIC_API_KEY=

# --- codex (OpenAI) ---
# Used by `codex exec`. CODEX_HOME points at the codex config/auth dir.
OPENAI_API_KEY=
# CODEX_HOME=~/.codex

# --- hermes ---
# Hermes selects its inference model from env/config (~/.hermes).
# HERMES_INFERENCE_MODEL=

# --- openclaw ---
# CLI not installed on this machine yet; add its key here once provisioned.
# OPENCLAW_API_KEY=

# --- fort-core ---
# HTTP/WS API bind address for fort-core (health, events, command API).
FORT_ADDR=127.0.0.1:4087
# SQLite state-store path (run/node_run/route_decision/event).
FORT_DB=.fort-native/fort.db
# Active routing ruleset.
FORT_RULES=rules/v1.yaml
# Scoped root all native runtimes execute under (AO-041 least-privilege).
FORT_WORKROOT=.fort-native/work
