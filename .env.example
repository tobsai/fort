# Fort — environment template (AO-005). Copy to `.env`; never commit real keys.
# `.env` is git-ignored. Each agent CLI authenticates against its own provider;
# Fort only needs these present in the environment it spawns the CLIs in.

# --- claude (Anthropic) ---
# Used by the `claude` CLI in headless `-p/--print` mode.
ANTHROPIC_API_KEY=

# --- codex (OpenAI) ---
# Used by `codex exec`. CODEX_HOME points at the codex config/auth dir.
OPENAI_API_KEY=
# CODEX_HOME=~/.codex

# --- hermes ---
# Hermes selects its inference model from env/config (~/.hermes).
# HERMES_INFERENCE_MODEL=

# --- openclaw ---
# Provider added (spec 023); the CLI invocation is a best guess until probed.
# Add its key here once provisioned.
# OPENCLAW_API_KEY=

# --- fort-core ---
# HTTP/WS API bind address. Use 0.0.0.0:4087 to expose on the LAN (needed for a
# machine that accepts remote exec in a multi-machine mesh).
FORT_ADDR=127.0.0.1:4087
# SQLite state-store path (run/node_run/route_decision/event).
FORT_DB=.fort-native/fort.db
# Active routing ruleset. When absent, the binary uses its embedded default
# (so `brew install fort && fort serve` works with no repo checkout).
FORT_RULES=rules/v1.yaml
# Scoped root all native runtimes execute under (AO-041 least-privilege).
FORT_WORKROOT=.fort-native/work

# --- multi-machine orchestration (spec 022 / mesh enrollment spec 024) ---
# `fort mesh invite` / `fort mesh join` persist NodeName/NodeToken/Addr in this
# host's .fort-native/node.yaml for you, so in the common case you don't need
# to set the vars below by hand. Precedence is env > node.yaml > defaults, so
# anything you do set here still wins over what node.yaml has on disk.
#
# Path to the machine registry. Unset = single-machine (everything runs locally).
# FORT_MACHINES=machines.yaml
# This host's identity in the registry (default: OS hostname).
# FORT_NODE_NAME=mac-mini
# Shared bearer token authenticating inter-Fort /api/exec calls. Set on every
# host that dispatches to, or accepts work from, a peer.
# FORT_NODE_TOKEN=change-me
